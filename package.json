{
  "name": "dsh-rhine-splash",
  "description": "Rhine Lab inspired theme for DeepSeek Harness: boot splash, interface theme, brand marks and extras",
  "version": "0.2.8",
  "license": "MIT",
  "author": "ArtemisFowl (https://github.com/Respawn-ID)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Respawn-ID/dsh-rhine-splash.git"
  },
  "homepage": "https://github.com/Respawn-ID/dsh-rhine-splash#readme",
  "bugs": {
    "url": "https://github.com/Respawn-ID/dsh-rhine-splash/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "splash-screen",
    "arknights"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/host/*.js",
    "lib/splash.css",
    "lib/splash.js",
    "assets/*.jpg",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/client.js",
    "lib/theme.css",
    "lib/brand/*"
  ],
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "test": "node scripts/test-host.mjs && node scripts/test-client.mjs",
    "check-dsh": "node scripts/check-dsh.mjs",
    "preview": "python3 -m http.server 4173"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
